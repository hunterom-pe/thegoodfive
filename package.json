    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
