# Copy to .env.local for development. On Netlify, set these under
# Site configuration → Environment variables.
#
# Leave both blank to run in clearly labelled DEMO mode with sample stories.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Supabase → Project Settings → API → "anon" / publishable key.
# This key is designed to be public: it can only do what row-level security allows.
VITE_SUPABASE_ANON_KEY=

# Timezone that decides which day is "today" for readers (IANA name). Default UTC.
VITE_EDITION_TIMEZONE=UTC

# ── Server-only secrets (Phase 3) ────────────────────────────────────────
# NEVER prefix these with VITE_: everything prefixed VITE_ is shipped to every
# visitor's browser. These are read only by Netlify Functions and `npm run draft`.
# On Netlify set them under Site configuration → Environment variables and
# mark them "Contains secret values". Locally, put them in .env.local.

# Supabase → Project Settings → API → service_role key. Bypasses row-level
# security. Never share it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# https://platform.openai.com/api-keys (set a monthly spend limit on the project)
OPENAI_API_KEY=
# Any model that supports JSON-schema structured output. Default: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
# A long random string. Lets our functions call the background function; the
# public cannot. Generate one with:  openssl rand -hex 32
GENERATION_SECRET=
# Timezone that decides which day a draft is for. Default America/Phoenix.
EDITION_TIMEZONE=America/Phoenix
# Spending guard: most generation runs allowed per edition date (default 4)
MAX_RUNS_PER_DAY=4
