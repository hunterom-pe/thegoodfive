# Copy to .env.local for development. On Netlify, set these under
# Site configuration → Environment variables.
#
# Leave both blank to run in clearly labelled DEMO mode with sample stories.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Supabase → Project Settings → API → "anon" / publishable key.
# This key is designed to be public: it can only do what row-level security allows.
VITE_SUPABASE_ANON_KEY=

# Timezone that decides which day is "today" for readers (IANA name). Default UTC.
VITE_EDITION_TIMEZONE=UTC

# ── Server-only secrets (Phase 3) ────────────────────────────────────────
# NEVER prefix these with VITE_: everything prefixed VITE_ is shipped to every
# visitor's browser. These are read only by Netlify Functions and `npm run draft`.
# On Netlify set them under Site configuration → Environment variables and
# mark them "Contains secret values". Locally, put them in .env.local.

# Supabase → Project Settings → API → service_role key. Bypasses row-level
# security. Never share it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Google Gemini (preferred). Key from https://aistudio.google.com/apikey; paste it
# exactly, with no quotes. AI Studio keys start with "AQ." or "AIza": both work.
# Check it with:  npm run ai:check   (prints a fingerprint, never the key)
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Legacy / other providers (used only when GEMINI_API_KEY is not set; GEMINI_* wins).
# OpenAI: https://platform.openai.com/api-keys (set a monthly spend limit)
# Any OpenAI-compatible provider also works through OPENAI_BASE_URL, e.g.
# Local Ollama:  http://localhost:11434/v1  (model e.g. llama3.1; key can be any text)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Optional, for "thinking" models such as Gemini: low or none makes them much faster.
AI_REASONING_EFFORT=
# Optional: seconds to wait for each AI call (default 240).
AI_TIMEOUT_SECONDS=240
# A long random string. Lets our functions call the background function; the
# public cannot. Generate one with:  openssl rand -hex 32
GENERATION_SECRET=
# Timezone that decides which day a draft is for. Default America/Phoenix.
EDITION_TIMEZONE=America/Phoenix
# ── Photography (Phase 4) ─────────────────────────────────────────────────
# Licensed photos from Unsplash. Free: create an app at https://unsplash.com/oauth/applications
# (demo mode allows 50 requests/hour, plenty for one draft a day) and copy its ACCESS KEY.
# Do not use the Secret Key; it is not needed. Server-side only: never a VITE_ variable.
# Without it, drafts still get the article's own image as an UNAPPROVED candidate for you to review.
UNSPLASH_ACCESS_KEY=
# The utm_source on attribution links (must not contain the word "unsplash"). Default: thegoodfive
UNSPLASH_APP_NAME=thegoodfive

# ── Automatic daily publishing (Phase 5) ───────────────────────────────────
# OFF by default. When "true", a verified edition publishes itself at 7:00 AM Phoenix time
# with no one reading it first (see README: "Automatic publishing"). Anything other than
# exactly "true" leaves it off, and the editor keeps working exactly as before.
AUTO_PUBLISH_ENABLED=false
# Optional: get a message when something fails. Any incoming-webhook URL works (Slack,
# Discord, ntfy.sh, Make, Zapier...). Leave blank for no alerts. Must be https.
ALERT_WEBHOOK_URL=
# Optional: extra publications you trust enough to publish unattended, comma separated.
# The built-in list is in server/pipeline/sources.ts.
EXTRA_TRUSTED_DOMAINS=

# Spending guard: most generation runs allowed per edition date (default 4)
MAX_RUNS_PER_DAY=4
